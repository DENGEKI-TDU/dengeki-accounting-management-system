# ============================================================
# account-system(会計システム)の環境変数の見本
# `npm run create-env`(ルート)でこのファイルが .env にコピーされる。
# 値は Discord「劇部鯖 > シス管 > env-backup > account-system」スレッドにある。
# ⚠️ NEXT_PUBLIC_ で始まる変数はブラウザに配信され、誰でも見られる。秘密の値を入れないこと。
# ============================================================

# レシート画像の保存先(Supabase Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 保存した画像の公開 URL の先頭部分(末尾は / で終える)
NEXT_PUBLIC_SUPABASE_PUBLIC_URL=

# 中継先の API サーバー(省略時: 本番 https://api.dengeki-fox.net / 開発 http://localhost:3006)
API_ORIGIN=

# --- 以下は現在のコードから参照されていない(2026-11 時点)。不要なら削除してよい ---
# DATABASE_URL=            (DB へのアクセスは api 経由になり、Prisma を使わなくなった)
# JWT_KEY=
# NEXT_PUBLIC_DB_API_KEY=
# NEXT_PUBLIC_DB_URL=
# EARNINGPASS=
# NEXT_PUBLIC_ALLOW_HOSTNAME=
# NEXT_PUBLIC_SSO_DOMAIN=
# REACT_EDITOR=
# DENGEKI_DOMAIN=
# SECRETKEY=
# IV=
# DISCORD_SERVER_ID=
